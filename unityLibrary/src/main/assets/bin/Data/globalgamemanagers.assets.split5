UNITY_BINDING(0) uniform DepthPyramidConstants {
	uint _MinDstCount;
	uint _CbDstCount;
	uint _DepthPyramidPad0;
	uint _DepthPyramidPad1;
	ivec2 _SrcOffset;
	ivec2 _SrcLimit;
	ivec2 _DstSize0;
	ivec2 _DstSize1;
	ivec2 _DstSize2;
	ivec2 _DstSize3;
	ivec2 _MinDstOffset0;
	ivec2 _MinDstOffset1;
	ivec2 _MinDstOffset2;
	ivec2 _MinDstOffset3;
	ivec2 _CbDstOffset0;
	ivec2 _CbDstOffset1;
