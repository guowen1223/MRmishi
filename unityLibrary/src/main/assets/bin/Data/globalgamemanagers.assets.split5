    u_xlati2.xy = min(u_xlati2.xy, ivec2(_SrcLimit.x, _SrcLimit.y));
    u_xlatu4.xy = uvec2(u_xlati2.xy) + uvec2(_SrcOffset.xy);
    u_xlatu4.zw = gl_WorkGroupID.zz;
